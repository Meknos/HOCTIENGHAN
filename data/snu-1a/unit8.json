  "grammar": [
    {
      "orderInUnit": 1,
      "pattern": "N을/를",
      "titleVn": "Trợ từ tân ngữ",
      "explanationVn": "Trợ từ '을/를' đi sau danh từ để chỉ đối tượng tác động trực tiếp của động từ. '을' đi sau danh từ có patchim (nguyên âm cuối), '를' đi sau danh từ không có patchim. Nó chỉ ra rằng danh từ đó bị ảnh hưởng bởi hành động được mô tả trong động từ.",
      "rule": "Danh từ có patchim + 을 | Danh từ không có patchim + 를",
      "pronunciationTip": "Khi '를' đứng sau '이', đọc thành '를'. Ví dụ: 커피를 - [커피를]",
      "examples": [
        {
          "korean": "커피를 마셔요.",
          "meaningVn": "Tôi uống cà phê."
        },
        {
          "korean": "밥을 먹어요.",
          "meaningVn": "Tôi ăn cơm."
        },
        {
          "korean": "신문을 읽어요.",
          "meaningVn": "Tôi đọc báo."
        }
      ],
      "exercises": [
