  "grammar": [
    {
      "orderInUnit": 1,
      "pattern": "V-아요/어요",
      "titleVn": "Thì hiện tại (thể thân mật lịch sự)",
      "explanationVn": "Đuôi câu hiện tại lịch sự. Chia theo nguyên âm cuối của gốc động từ: gốc có ㅏ/ㅗ → 아요; còn lại → 어요; 하다 → 해요.",
      "rule": "ㅏ/ㅗ → 아요 · khác → 어요 · 하다 → 해요",
      "examples": [
        { "korean": "가다 → 가요", "meaningVn": "đi → đi (hiện tại)" },
        { "korean": "먹다 → 먹어요", "meaningVn": "ăn → ăn" },
        { "korean": "공부하다 → 공부해요", "meaningVn": "học → học" }
      ],
      "exercises": [
        { "type": "fill_blank", "question": "읽다 → 읽___ (hiện tại lịch sự)", "answer": "어요" },
        { "type": "multiple_choice", "question": "오다 → ?", "answer": "와요", "options": ["와요", "오아요", "오어요", "와아요"] }
      ]
    },
    {
      "orderInUnit": 2,
      "pattern": "N을/를",
      "titleVn": "Trợ từ tân ngữ (đối tượng của hành động)",
      "explanationVn": "Đánh dấu tân ngữ trực tiếp của động từ. Chọn theo 받침 của danh từ.",
      "rule": "받침 O → 을 · 받침 X → 를",
      "examples": [
        { "korean": "밥을 먹어요.", "meaningVn": "Tôi ăn cơm." },
        { "korean": "커피를 마셔요.", "meaningVn": "Tôi uống cà phê." }
      ],
      "exercises": [
        { "type": "fill_blank", "question": "책___ 읽어요. (받침 O)", "answer": "을" },
        { "type": "fill_blank", "question": "영화___ 봐요. (받침 X)", "answer": "를" }
      ]
    },
    {
      "orderInUnit": 3,
      "pattern": "N에서",
      "titleVn": "Tại N (nơi diễn ra hành động)",
      "explanationVn": "Trợ từ chỉ địa điểm nơi hành động diễn ra. Khác với 에 (chỉ đích đến / vị trí tồn tại).",
      "rule": "N + 에서 + động từ hành động",
      "examples": [
        { "korean": "도서관에서 공부해요.", "meaningVn": "Tôi học ở thư viện." },
        { "korean": "식당에서 밥을 먹어요.", "meaningVn": "Tôi ăn cơm ở quán." }
      ],
      "exercises": [
        { "type": "fill_blank", "question": "카페___ 커피를 마셔요. (tại)", "answer": "에서" },
        { "type": "reorder", "question": "Sắp xếp: \"Tôi học ở thư viện.\"", "answer": "도서관에서 공부해요", "options": ["공부해요", "도서관에서"] }
      ]
    },
    {
      "orderInUnit": 4,
      "pattern": "안 V",
      "titleVn": "Phủ định: không làm gì",
      "explanationVn": "Đặt 안 trước động từ/tính từ để phủ định. Với động từ 하다, 안 đặt trước 하다 (예: 공부 안 해요).",
      "rule": "안 + V/A  |  N하다 → N 안 해요",
      "examples": [
        { "korean": "안 가요.", "meaningVn": "Tôi không đi." },
        { "korean": "공부 안 해요.", "meaningVn": "Tôi không học." }
      ],
      "exercises": [
        { "type": "fill_blank", "question": "밥을 ___ 먹어요. (không)", "answer": "안" }
      ]
    }
