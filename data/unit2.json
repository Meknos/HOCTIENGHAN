  "grammar": [
    {
      "orderInUnit": 1,
      "pattern": "N이/가 있어요[없어요]",
      "titleVn": "Có / Không có N",
      "explanationVn": "Diễn tả sự tồn tại/sở hữu. 있어요 = có, 없어요 = không có. Danh từ gắn trợ từ chủ ngữ 이/가 theo 받침.",
      "rule": "받침 O → 이 있어요/없어요  |  받침 X → 가 있어요/없어요",
      "examples": [
        { "korean": "책이 있어요.", "meaningVn": "Có sách." },
        { "korean": "지우개가 없어요.", "meaningVn": "Không có cục tẩy." }
      ],
      "exercises": [
        { "type": "fill_blank", "question": "가방___ 있어요. (받침 O)", "answer": "이" },
        { "type": "multiple_choice", "question": "시계___ 없어요.", "answer": "가", "options": ["가", "이", "는", "를"] }
      ]
    },
    {
      "orderInUnit": 2,
      "pattern": "N 주세요",
      "titleVn": "Cho tôi N (yêu cầu lịch sự)",
      "explanationVn": "Dùng để xin/yêu cầu một vật gì đó một cách lịch sự. Đặt danh từ trước 주세요.",
      "rule": "N + 주세요",
      "examples": [
        { "korean": "물 주세요.", "meaningVn": "Cho tôi nước." },
        { "korean": "연필 주세요.", "meaningVn": "Cho tôi bút chì." }
      ],
      "exercises": [
        { "type": "fill_blank", "question": "볼펜 ___. (làm ơn cho tôi)", "answer": "주세요" }
      ]
    },
    {
      "orderInUnit": 3,
      "pattern": "N하고 N · N과/와 N",
      "titleVn": "N và N (liệt kê)",
      "explanationVn": "Nối hai danh từ. 하고 dùng trong văn nói (mọi trường hợp). 과/와 trang trọng hơn: 받침 O dùng 과, 받침 X dùng 와.",
      "rule": "하고 (nói) · 받침 O → 과 · 받침 X → 와",
      "examples": [
        { "korean": "책하고 공책이 있어요.", "meaningVn": "Có sách và vở." },
        { "korean": "연필과 지우개", "meaningVn": "Bút chì và cục tẩy." },
        { "korean": "의자와 책상", "meaningVn": "Ghế và bàn." }
      ],
      "exercises": [
